# Copy to `.env` for local development. `.env` is git-ignored and must never be committed.
# This file holds NO secrets: every credential below is intentionally empty.
# Phase 1 code reads none of these; they document variables the pinned `laya` package already honours.

# --- Hugging Face (only needed for tests marked `weights`/`network`; the default test run is offline)
HF_HUB_OFFLINE=1
# HF_HOME=
# Read-only token, only if a private checkpoint is used. Prefer `huggingface-cli login` over this file.
HF_TOKEN=

# --- Laya runtime (read by the pinned `laya` package)
# `reviewed` pins every checkpoint load to the SHAs Laya ships in PINNED_REVISIONS.
LAYA_REVISION=reviewed
LAYA_DEVICE=cpu
